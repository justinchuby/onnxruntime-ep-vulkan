// The unary elementwise template — 42 op selectors, 92 compiled variants, one file.
//
// Nothing here knows what op it is compiling: `EW_OP` selects an expression, `SCALAR_T`/`DTYPE_*`
// select the element type, and `indexing.glsl` supplies the addressing. Adding a unary op is a row
// in `src/ops/elementwise.rs` plus a case below — never a new file.
//
// Numerical note: f16 tensors are *stored* as `float16_t` and *computed* in `float`. That is a
// deliberate accuracy gain over computing in half, and it removes any dependency on f16 overloads
// of the transcendental builtins.
//
// Ops carrying attributes (LeakyRelu's alpha, Elu's alpha, Shrink's bias/lambd, ...) read their
// values from the push-constant parameter tail, `pc.params[0..4]`, which the host fills from the
// node's real attributes. They were previously compiled with the ONNX *default* values baked in
// and staged `NEEDS_PARAMS`, claiming nothing — `OP_COVERAGE.md` §7.1: an op is claimed only when
// the attribute combination is genuinely handled, and a default is not a handled value, it is a
// guess. The tail is what turned the guess into a handled value; see §5.1.1.

#version 450
#extension GL_GOOGLE_include_directive : require

#define EW_ARITY 1
#include "op_codes.glsl"
#include "indexing.glsl"

layout(local_size_x_id = 0, local_size_x = 256) in;

// -- bindings ---------------------------------------------------------------------------------

#if defined(EW_PACKED_BYTES)
layout(set = 0, binding = 0) readonly buffer In0 { uint data[]; } in0;
EW_DEFINE_LOAD_BYTE(load0, in0)
#elif defined(EW_PACKED_HALF)
layout(set = 0, binding = 0) readonly buffer In0 { uint data[]; } in0;
EW_DEFINE_LOAD_HALF(load0, in0)
#else
layout(set = 0, binding = 0) readonly buffer In0 { SCALAR_T data[]; } in0;
EW_DEFINE_LOAD(load0, in0)
#endif

#if defined(EW_BOOL_RESULT) || defined(EW_PACKED_BYTES)
layout(set = 0, binding = 1) buffer Out { uint data[]; } outb;
EW_DEFINE_STORE_BYTE(store_out, outb)
#elif defined(EW_PACKED_HALF)
layout(set = 0, binding = 1) buffer Out { uint data[]; } outb;
EW_DEFINE_STORE_HALF(store_out, outb)
#else
layout(set = 0, binding = 1) writeonly buffer Out { SCALAR_T data[]; } outb;
EW_DEFINE_STORE(store_out, outb)
#endif

// -- helpers ----------------------------------------------------------------------------------

#ifdef EW_FLOAT
// Abramowitz & Stegun 7.1.26. Max absolute error ~1.5e-7, which is inside the f32 conformance
// tolerance and far inside f16's. `Erf` is on the LLM path via the exact `Gelu`, so this is one
// of the two approximations in this file whose accuracy is load-bearing (see `ew_asin_core`).
float ew_erf(float x) {
    const float p  =  0.3275911;
    const float a1 =  0.254829592;
    const float a2 = -0.284496736;
    const float a3 =  1.421413741;
    const float a4 = -1.453152027;
    const float a5 =  1.061405429;
    float s = sign(x);
    float ax = abs(x);
    float t = 1.0 / (1.0 + p * ax);
    float poly = ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t;
    return s * (1.0 - poly * exp(-ax * ax));
}

// Branch-selected rather than `1/(1+exp(-x))` so neither tail overflows.
float ew_sigmoid(float x) {
    if (x >= 0.0) {
        return 1.0 / (1.0 + exp(-x));
    }
    float e = exp(x);
    return e / (1.0 + e);
}

// log(1 + exp(x)), evaluated so the positive tail does not overflow.
float ew_softplus(float x) {
    return max(x, 0.0) + log(1.0 + exp(-abs(x)));
}

// -- portable inverse trigonometry (§8.9.28) ---------------------------------------------------
//
// Why this exists instead of GLSL's `asin()`/`acos()`. Vulkan's "Precision of GLSL.std.450
// Instructions" table does not give `asin`/`acos` a bound of their own: it defines each one *by
// inheritance*, `asin(x)` from `atan2(x, sqrt(1 - x*x))` and `acos(x)` from
// `atan2(sqrt(1 - x*x), x)`. `atan`/`atan2` is then allowed **4096 ULP** in single precision,
// roughly 2.4e-4 relative. So a driver may miss our 1e-5 op tolerance by more than an order of
// magnitude and still be perfectly conformant, and a green result on one vendor says nothing
// about any other. Measured on this repo's own lavapipe lane, the built-in path was 3831 ULP
// (Asin) and 3903 ULP (Acos) from the ORT CPU EP -- inside the driver's allowance, outside ours.
// See docs/DESIGN.md §8.9.28 and issue #4; the fix is ours to own, not the driver's to fix.
//
// The algorithm is Cephes `asinf` (Moshier), an established f32 minimax, evaluated entirely in
// operations the same spec table requires to be correctly rounded (OpFMul/OpFAdd/OpFSub) plus one
// `sqrt`. Range reduction folds [0,1] onto the core's [0,1/2] via
// asin(a) = pi/2 - 2*asin(sqrt((1-a)/2)) for a > 1/2.
//
// Derived (not driver-fitted) bound: the core polynomial is <= 2.42 ULP for asin and <= 1.28 ULP
// for acos, measured in exact float32 over 4,000,001 points; on the reflected branch `sqrt`'s
// <= 4.5 ULP (itself inherited, from `1.0 / inversesqrt()`) is doubled by the `2*r` and amplified
// by 1/sqrt(1-s^2), worst at the s = 1/2 seam, for <= ~10.4 ULP. 2.42 + 10.4 rounds up to the
// 16 ULP (~1.9e-6 relative) this shader claims, which is 5x inside FP32_TRANSCENDENTAL. Measured
// end to end: 4 ULP (Asin) / 5 ULP (Acos) on *both* lavapipe and NVIDIA -- the point is not that
// the number got smaller on one device, it is that it is now the same number on every device.
//
// `Asin` and `Acos` deliberately share `ew_asin_abs` so the two cannot drift into different
// approximations of the same function.

// asin(s) for s in [0, 1/2], as the odd series s + s^3 * P(s^2). Cephes `asinf` coefficients.
float ew_asin_core(float s) {
    float z = s * s;
    float p = 4.2163199048e-2;
    p = p * z + 2.4181311049e-2;
    p = p * z + 4.5470025998e-2;
    p = p * z + 7.4953002686e-2;
    p = p * z + 1.6666752422e-1;
    return (p * z) * s + s;
}

// Quiet NaN by bit pattern. `0.0 / 0.0` is not dependable here: the driver may be compiling under
// fast-math assumptions, and `shaderSignedZeroInfNanPreserveFloat32` is a property we may read,
// not a guarantee we may require of every device we run on.
#define EW_QNAN uintBitsToFloat(0x7fc00000u)

// asin(|x|) for a = |x| in [0, 1]. Shared by both ops; callers own the sign and the domain check.
float ew_asin_abs(float a) {
    bool refl = a > 0.5;
    // `max(..., 0.0)`: GLSL leaves sqrt of a negative operand undefined, and rounding in
    // `0.5 - 0.5*a` can land a hair below zero at a == 1.
    float z = refl ? max(0.5 - 0.5 * a, 0.0) : a * a;
    float s = refl ? sqrt(z) : a;
    float r = ew_asin_core(s);
    return refl ? (1.5707963267948966 - 2.0 * r) : r;
}

float ew_asin(float x) {
    float m = ew_asin_abs(abs(x));
    // Copy the sign bit rather than multiplying by `sign(x)`: sign(-0.0) is +0.0 in GLSL, which
    // would turn ONNX's required asin(-0) = -0 into +0.
    m = uintBitsToFloat((floatBitsToUint(x) & 0x80000000u) | floatBitsToUint(m));
    // False for NaN as well as for |x| > 1, so out-of-domain and NaN-in-NaN-out are one test.
    return (x >= -1.0 && x <= 1.0) ? m : EW_QNAN;
}

float ew_acos(float x) {
    float a = abs(x);
    bool refl = a > 0.5;
    float z = refl ? max(0.5 - 0.5 * a, 0.0) : a * a;
    float s = refl ? sqrt(z) : a;
    float r = ew_asin_core(s);
    // On the reflected branch acos(a) = 2*asin(sqrt((1-a)/2)) directly, which avoids forming
    // pi/2 - asin(x) out of two nearly equal quantities where the result is near zero.
    float m = refl ? (x > 0.0 ? (2.0 * r) : (3.14159265358979324 - 2.0 * r))
                   : (1.5707963267948966 - (x < 0.0 ? -r : r));
    return (x >= -1.0 && x <= 1.0) ? m : EW_QNAN;
}
#endif

// -- the op ------------------------------------------------------------------------------------

#if EW_OP == OP_ISINF
// Declared here rather than in `indexing.glsl` so only the two `isinf` modules change shape. See
// the header note there: an unused declaration in the shared header would have rewritten every
// elementwise module's SPIR-V digest and faulted the whole proof ledger.
layout(constant_id = 2) const uint EW_SELECTOR = 0;
#endif

#ifdef EW_BOOL_RESULT
uint apply_bool(COMPUTE_T x) {
#if EW_OP == OP_NOT
    return x != COMPUTE_T(0) ? 0u : 1u;
#elif EW_OP == OP_ISNAN
    return isnan(x) ? 1u : 0u;
#elif EW_OP == OP_ISINF
    // ONNX `IsInf` carries `detect_positive` and `detect_negative`, both defaulting to 1. They
    // choose an expression rather than supply a value, so they arrive in `EW_SELECTOR`
    // (bit 0 = detect_positive, bit 1 = detect_negative) rather than in `pc.params`, and both
    // tests below fold at pipeline creation.
    //
    // `isinf(x) && x > 0` rather than `x == +inf`: the comparison is exact for infinities either
    // way, and this form does not depend on the compiler keeping a literal infinity finite under
    // whatever fast-math the driver applies.
    return (isinf(x)
            && (((EW_SELECTOR & 1u) != 0u && x > COMPUTE_T(0))
                || ((EW_SELECTOR & 2u) != 0u && x < COMPUTE_T(0)))) ? 1u : 0u;
#else
#error "EW_OP claims a boolean result but ew_unary.comp has no case for it"
#endif
}
#else
COMPUTE_T apply(COMPUTE_T x) {
#if EW_OP == OP_IDENTITY
    return x;

// ---- sign-symmetric arithmetic, defined for ints as well as floats ----
#elif EW_OP == OP_ABS
#ifdef EW_FLOAT
    return abs(x);
#else
    return x < COMPUTE_T(0) ? -x : x;
#endif
#elif EW_OP == OP_NEG
    return -x;
#elif EW_OP == OP_SIGN
#ifdef EW_FLOAT
    return sign(x);
#else
    return x > COMPUTE_T(0) ? COMPUTE_T(1) : (x < COMPUTE_T(0) ? COMPUTE_T(-1) : COMPUTE_T(0));
#endif

// ---- integer-only ----
#elif EW_OP == OP_BITNOT
    return ~x;

// ---- floating point ----
#elif EW_OP == OP_RECIP
    return 1.0 / x;
#elif EW_OP == OP_SQRT
    return sqrt(x);
#elif EW_OP == OP_EXP
    return exp(x);
#elif EW_OP == OP_LOG
    return log(x);
#elif EW_OP == OP_SIN
    return sin(x);
#elif EW_OP == OP_COS
    return cos(x);
#elif EW_OP == OP_TAN
    return tan(x);
#elif EW_OP == OP_ASIN
    return ew_asin(x);
#elif EW_OP == OP_ACOS
    return ew_acos(x);
#elif EW_OP == OP_ATAN
    return atan(x);
#elif EW_OP == OP_SINH
    return sinh(x);
#elif EW_OP == OP_COSH
    return cosh(x);
#elif EW_OP == OP_TANH
    return tanh(x);
#elif EW_OP == OP_ASINH
    return asinh(x);
#elif EW_OP == OP_ACOSH
    return acosh(x);
#elif EW_OP == OP_ATANH
    return atanh(x);
#elif EW_OP == OP_CEIL
    return ceil(x);
#elif EW_OP == OP_FLOOR
    return floor(x);
#elif EW_OP == OP_ROUND
    // ONNX `Round` is round-half-to-even, which is `roundEven`, not `round`.
    return roundEven(x);
#elif EW_OP == OP_ERF
    return ew_erf(x);

// ---- activations ----
#elif EW_OP == OP_RELU
    return max(x, 0.0);
#elif EW_OP == OP_SIGMOID
    return ew_sigmoid(x);
#elif EW_OP == OP_SWISH
    // ONNX opset 24 `Swish`: x * sigmoid(alpha * x). params[0]=alpha. alpha = 1 is SiLU, the
    // activation every SwiGLU MLP in the LLM tiers uses; the general form costs one multiply.
    return x * ew_sigmoid(pc.params[0] * x);
#elif EW_OP == OP_HARDSWISH
    return x * clamp(x / 6.0 + 0.5, 0.0, 1.0);
#elif EW_OP == OP_SOFTPLUS
    return ew_softplus(x);
#elif EW_OP == OP_SOFTSIGN
    return x / (1.0 + abs(x));
#elif EW_OP == OP_MISH
    return x * tanh(ew_softplus(x));
#elif EW_OP == OP_GELU
    // approximate="none" (the default): the exact erf form.
    return 0.5 * x * (1.0 + ew_erf(x * 0.70710678118654752));
// --- parameterised activations ------------------------------------------------------------
// Everything below reads its attributes from `pc.params`, filled by the host from the node's
// real attribute values (`ops::common::params`). The slot assignment is duplicated in that
// module's doc comment and asserted by its tests; nothing here may reorder a slot.
#elif EW_OP == OP_HARDSIGMOID
    // params[0]=alpha, params[1]=beta.
    return clamp(pc.params[0] * x + pc.params[1], 0.0, 1.0);
#elif EW_OP == OP_LEAKYRELU
    // params[0]=alpha.
    return x < 0.0 ? pc.params[0] * x : x;
#elif EW_OP == OP_ELU
    // params[0]=alpha.
    return x < 0.0 ? pc.params[0] * (exp(x) - 1.0) : x;
#elif EW_OP == OP_SELU
    // params[0]=alpha, params[1]=gamma.
    return pc.params[1] * (x > 0.0 ? x : pc.params[0] * (exp(x) - 1.0));
#elif EW_OP == OP_CELU
    // params[0]=alpha. Note the division: unlike Elu, Celu scales the *argument* too, so an
    // alpha of 0 is a division by zero and the claim predicate rejects it rather than relying
    // on the implementation-defined result.
    return max(0.0, x) + min(0.0, pc.params[0] * (exp(x / pc.params[0]) - 1.0));
#elif EW_OP == OP_TRELU
    // params[0]=alpha.
    return x > pc.params[0] ? x : 0.0;
#elif EW_OP == OP_SHRINK
    // params[0]=lambd, params[1]=bias.
    return x < -pc.params[0] ? x + pc.params[1]
         : (x > pc.params[0] ? x - pc.params[1] : 0.0);
#else
#error "ew_unary.comp has no case for this EW_OP"
#endif
}
#endif

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.elem_count) {
        return;
    }
    COMPUTE_T x = load0(ew_index(0u, gid));
#ifdef EW_BOOL_RESULT
    store_out(gid, apply_bool(x));
#else
    store_out(gid, apply(x));
#endif
}
