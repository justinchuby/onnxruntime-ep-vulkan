// GlobalAveragePool (f32) — ONNX `GlobalAveragePool`, 4-D. Owner: Mouse.
//
// THE MAPPING
// -----------
//   X : [N, C, H, W]
//   Y : [N, C, 1, 1]
//
//   Y[n, c] = (1 / (H * W)) * sum over (y, x) of X[n, c, y, x]
//
// One invocation per output element, i.e. per `(n, c)` pair, each reducing a contiguous
// `H * W` run. Contiguous because ONNX's NCHW layout puts the spatial window last, so the
// reduction is a linear scan and needs no index arithmetic beyond its base.
//
// WHY ONE INVOCATION PER CHANNEL AND NOT A WORKGROUP REDUCTION
// ------------------------------------------------------------
// A tree reduction inside a workgroup would use more of the device on a large spatial window.
// It would also sum in a different order, and this kernel's oracle is ORT's CPU reference,
// which accumulates in f32 in loop order. Matching the reference's order is the property that
// makes the differential comparison a test of one implementation rather than of two
// algorithms; the parallel version is a separate, measured change with this as its oracle.
// MobileNetV2's pool reduces 49 elements over 1280 channels, so the serial loop is 49 long.
//
// The accumulator is `float` for the same reason, and deliberately not `double`.
//
// Grid-stride loop so the workgroup count stays under any device's
// maxComputeWorkGroupCount[0] rather than scaling with the batch.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x_id = 0, local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint hw;       // H * W, the spatial window and the divisor
    uint total;    // N * C, the output element count
} pc;

layout(set = 0, binding = 0) readonly  buffer X { float data[]; } u_x;
layout(set = 0, binding = 1) writeonly buffer Y { float data[]; } u_y;

void main() {
    uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    for (uint o = gl_GlobalInvocationID.x; o < pc.total; o += stride) {
        uint base = o * pc.hw;
        float acc = 0.0;
        for (uint i = 0u; i < pc.hw; ++i) {
            acc += u_x.data[base + i];
        }
        // `hw` is never zero: the claim predicate declines an empty spatial window rather than
        // letting this divide produce an infinity that reads like an answer.
        u_y.data[o] = acc / float(pc.hw);
    }
}
