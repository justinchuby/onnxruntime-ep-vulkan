# THE DEVICE-LIST WIRE FORMAT CONTRACT — read by BOTH languages (issue #18, blocker B1).
#
# DESIGN.md 2.4.1.2 states the format. This file is the executable half of that statement, and it
# exists because the format had three readers and no writer-down: `counters.rs` emitted a bare
# `"; "` list, `gen_proof_ledger.py` required an `N=` prefix, and neither was wrong on its own
# terms — so nothing failed. `LedgerEntry.device_uuid` was simply `""` on every entry ever
# written, and the PROVEN / PROVEN-ELSEWHERE rows of `registry::device_state` were unreachable.
#
# Readers:
#   * rust/src/registry.rs `mod tests`         (parse, DeviceKey round-trip, into device_state,
#                                               and the planted rejected-parser mutation)
#   * tests/ops/test_device_identity_wire.py   (parse, full ledger generation, the same mutation)
#
# JSONL rather than JSON so both readers are one line of code: Python `json.loads` per line, Rust
# `registry::json_field` per line. `#` comment lines and blank lines are skipped. This is the same
# shape, and the same reason, as `evidence/proof_ledger.jsonl`.
#
# kind=wire  — a counters value and what parsing it must yield.
# kind=state — a counters value plus one ledger entry, and the `device_state` verdict they produce.
#
# `origin` names where a string came from. "emitted" means it was copied out of a real artifact in
# this repo and is therefore evidence about the format rather than an opinion about it.
{"kind":"wire","case":"real_rtx_a1000_single_device","origin":"emitted: bench/results/rust-model-runner/mobilenetv2-12-device-selector.json (real RTX A1000 run)","running_device_uuids":"uuid:aadf33d4d118155fcc60c22b5c352463","running_device_names":"NVIDIA RTX A1000","keys":["uuid:aadf33d4d118155fcc60c22b5c352463"],"names":["NVIDIA RTX A1000"],"device_uuid":"aadf33d4d118155fcc60c22b5c352463","note":"THE case the rejected parser got wrong: no equals sign anywhere, so `if '=' in p` selected nothing and device_uuid was empty"}
{"kind":"wire","case":"two_cards_bare","origin":"emitted shape: bench/results/gqa_grouping_grow_dev1.counters.json carries the two-name form","running_device_uuids":"uuid:11111111111111111111111111111111; uuid:22222222222222222222222222222222","running_device_names":"Intel(R) Iris(R) Xe Graphics; NVIDIA GeForce RTX 4060 Laptop GPU","keys":["uuid:11111111111111111111111111111111","uuid:22222222222222222222222222222222"],"names":["Intel(R) Iris(R) Xe Graphics","NVIDIA GeForce RTX 4060 Laptop GPU"],"ledger_refuses":"2 distinct","note":"a proof entry names one device; a run that touched two cannot be attributed to either"}
{"kind":"wire","case":"unidentified_fallback","origin":"constructed: DeviceKey::Unidentified canonical() output, name first, index last","running_device_uuids":"unidentified:Mali-G78#0","running_device_names":"Mali-G78","keys":["unidentified:Mali-G78#0"],"names":["Mali-G78"],"device_uuid":"","note":"B2: the production spelling is unidentified:<name>#<index>, NOT unidentified:<index>:<name>. Process-local, so it yields no device_uuid and can never prove"}
{"kind":"wire","case":"mixed_identified_and_not","origin":"constructed","running_device_uuids":"uuid:aadf33d4d118155fcc60c22b5c352463; unidentified:Some Card#1","running_device_names":"NVIDIA RTX A1000; Some Card","keys":["uuid:aadf33d4d118155fcc60c22b5c352463","unidentified:Some Card#1"],"names":["NVIDIA RTX A1000","Some Card"],"device_uuid":"aadf33d4d118155fcc60c22b5c352463","note":"an unidentified sibling contributes no identity and does not make the identified one ambiguous"}
{"kind":"wire","case":"indexed_tolerance","origin":"emitted shape of a DIFFERENT counter: alloc_device_frame_session_devices writes 1=The Session's Device","running_device_uuids":"0=uuid:aadf33d4d118155fcc60c22b5c352463; 1=unidentified:Some Card#1","running_device_names":"0=NVIDIA RTX A1000; 1=Some Card","keys":["uuid:aadf33d4d118155fcc60c22b5c352463","unidentified:Some Card#1"],"names":["NVIDIA RTX A1000","Some Card"],"device_uuid":"aadf33d4d118155fcc60c22b5c352463","note":"tolerated, never required. A reader pointed at the wrong counter degrades to a right answer, not an empty one"}
{"kind":"wire","case":"name_containing_an_equals_sign","origin":"emitted: bench/results/link-linux-downstream/counters-linux.json names llvmpipe; the rev= suffix is the shape a Mesa build reports","running_device_uuids":"uuid:33333333333333333333333333333333","running_device_names":"llvmpipe (LLVM 20.1.2, 256 bits) rev=3","keys":["uuid:33333333333333333333333333333333"],"names":["llvmpipe (LLVM 20.1.2, 256 bits) rev=3"],"device_uuid":"33333333333333333333333333333333","note":"only a PURELY NUMERIC prefix is positional; splitting on the first equals sign renames this device to a bare 3"}
{"kind":"wire","case":"empty_value","origin":"emitted: the EP writes an empty string when it has nothing to report","running_device_uuids":"","running_device_names":"","keys":[],"names":[],"device_uuid":"","note":"an empty key list means no comparison is possible; it never means the identities agree"}
{"kind":"wire","case":"none_sentinel","origin":"emitted: allocator::tally returns none when no session has opened a device","running_device_uuids":"none","running_device_names":"none","keys":[],"names":[],"device_uuid":"","note":"a sentinel is a statement about the whole list, not an element of it"}
{"kind":"wire","case":"unknown_sentinel","origin":"emitted: allocator::tally returns unknown when its mutex is poisoned","running_device_uuids":"unknown","running_device_names":"unknown","keys":[],"names":[],"device_uuid":"","note":"an instrument that could not read is not an instrument that read nothing"}
{"kind":"wire","case":"index_with_no_body","origin":"constructed","running_device_uuids":"0=","running_device_names":"0=","keys":[],"names":[],"device_uuid":"","note":"an empty element is the absence of an identity, not an identity that happens to be empty"}
