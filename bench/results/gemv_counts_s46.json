      "hot_block_bodies_per_blob": 4
    },
    "QB_PACKED=1": {
      "inb_load_result_types": {
        "%v4uint": 1
      },
      "ina_load_result_types": {
        "%float": 2
      },
      "inb_load_width_bytes": 16,
      "loads_per_blob": 1,
      "accumulator_updates_per_blob": 1,
      "independent_partial_sums_per_update": 4,
      "serial_fp_adds_on_critical_path_per_blob": 3,
